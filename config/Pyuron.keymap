#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6


/* マウスレイヤー自動切り替え（クリック以外で通常に戻る）の設定 */
&pinctrl { };
/ {
    behaviors {
        // マウスレイヤー滞在中に「クリック以外のキー」を押したら、そのキーを入力しつつレイヤー0に戻す設定
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    // コンボ設定（同時押し）
    combos {
        compatible = "zmk,combos";

        // ① 左手 D + F 同時押しで「英語入力」に切り替え
        combo_lang_en {
            timeout-ms = <50>;
            key-positions = <12 13>; // D(12) と F(13) の位置
            bindings = <&kp LANG2>;  // Mac/Windows共通：英数/Alt+`相当
        };

        // ② 右手 J + K 同時押しで「日本語入力」に切り替え
        combo_lang_ja {
            timeout-ms = <50>;
            key-positions = <16 17>; // J(16) と K(17) の位置
            bindings = <&kp LANG1>;  // Mac/Windows共通：かな/ひらがな相当
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W      &kp E      &kp R         &kp T           &kp Y        &kp U          &kp I        &kp O              &kp P
&kp A             &kp S      &kp D      &kp F         &kp G           &kp H        &kp J          &kp K        &kp L              &kp SQT
&mt LEFT_SHIFT Z  &kp X      &kp C      &kp V         &kp B           &lt 4 COLON  &kp BACKSLASH  &kp N        &"https://github.com"
